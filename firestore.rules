rules_version = '2';

// Vaultlog cloud backup — owner-only access.
// Publish in Firebase Console (Firestore → Rules) or: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /userBackups/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
